{
  "servers": {
    "irctc": {
      "command": "node",
      "args": ["${workspaceFolder}/irctc-mcp/dist/index.js"]
    },
    "google-calendar": {
      "command": "npx",
      "args": ["-y", "@cocal/google-calendar-mcp"],
      "env": {
        "GOOGLE_OAUTH_CREDENTIALS": "${workspaceFolder}/.secrets/gcp-oauth.keys.json"
      }
    }
  }
}
